# App/runtime
APP_ENV=development
# Frontend origin used for redirects, reset links, and cookie flow.
FRONTEND_BASE_URL=http://localhost:5173
# Secure cookie flag for production deployments.
COOKIE_SECURE=false
# Primary FastAPI secret used for app-level signing or future use.
SECRET_KEY=
# Symmetric key (a `Fernet.generate_key()` value) used to encrypt third-party
# OAuth tokens at rest (GitHub). Leave blank in dev — a key is derived from
# SECRET_KEY instead; set a real generated one in any shared environment.
TOKEN_ENCRYPTION_KEY=

# Database
# SQLAlchemy connection string for Postgres.
DATABASE_URL=postgresql+psycopg://groundtruth:@localhost:5432/groundtruth

# Test database — a separate container (`make test-db-up`, port 5433).
# REQUIRED to run tests; tests/conftest.py hard-fails rather than falling
# back to DATABASE_URL if this is unset or resolves to a non-local host.
TEST_DATABASE_URL=postgresql+psycopg://groundtruth_test:groundtruth_test@localhost:5433/groundtruth_test

# JWT
# Signing secret for access, refresh, and state tokens.
JWT_SECRET_KEY=
# JWT algorithm used by the auth module.
JWT_ALGORITHM=HS256
# Access token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime in days.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# reCAPTCHA v2
# Public site key for the browser widget.
RECAPTCHA_SITE_KEY=
# Private secret key for server-side verification.
RECAPTCHA_SECRET_KEY=

# Mail
# Which Mailer backend `src/core/mail/backends.py` builds: "console" (logs
# only, default), "smtp" (real delivery — MailHog in docker-compose, a real
# provider in production), or "capture" (in-memory outbox, integration tests only).
MAIL_BACKEND=console
# SMTP host for transactional email delivery. docker-compose's `mailhog`
# service listens on localhost:1025 with no auth/TLS required.
SMTP_HOST=localhost
# SMTP port for the mail server.
SMTP_PORT=1025
# SMTP username used for authentication (leave blank for MailHog).
SMTP_USER=
# SMTP password used for authentication (leave blank for MailHog).
SMTP_PASSWORD=
# Whether to negotiate STARTTLS before sending (MailHog: false; most real providers: true).
SMTP_USE_TLS=false
# Sender address used in outbound auth emails.
SMTP_FROM_EMAIL=no-reply@groundtruth.ai

# Google OAuth
# OAuth client ID for the Google login flow.
GOOGLE_CLIENT_ID=
# OAuth client secret for the Google login flow.
GOOGLE_CLIENT_SECRET=
# Redirect URI registered in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# GitHub OAuth (read scopes only — connects a candidate's account to their
# GitHub identity for repository verification; see domains/student/github_oauth.py).
# OAuth App client ID, from github.com/settings/developers.
GITHUB_CLIENT_ID=
# OAuth App client secret.
GITHUB_CLIENT_SECRET=
# Callback URL registered on the GitHub OAuth App.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/student/github/callback
GITHUB_OAUTH_SCOPES=read:user public_repo

# CORS
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# Celery / Redis
# Broker and result backend for the background job layer.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Retry envelope: delay = base * 2**attempt, capped at max, with jitter.
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_BASE_SECONDS=5
JOB_RETRY_BACKOFF_MAX_SECONDS=600
# Hard/soft ceiling on a single task run, in seconds.
JOB_TIME_LIMIT_SECONDS=900
JOB_SOFT_TIME_LIMIT_SECONDS=840

# Object storage (S3-compatible: MinIO locally, S3/R2 in production)
# Leave the endpoint blank to talk to real AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=groundtruth
S3_SECRET_ACCESS_KEY=groundtruth-dev-secret
S3_RESUME_BUCKET=groundtruth-resumes
# Resumes are personal data: the bucket stays private and reads are presigned.
S3_PRESIGN_EXPIRY_SECONDS=300
# Uploads above this are rejected before the body is read (bytes).
RESUME_MAX_BYTES=10485760

# LLM — Google Gemini
# GroundTruth runs on one provider. Every model-backed capability goes through
# src/domains/ai/llm.py to Gemini: resume extraction, interview question
# generation, answer evaluation, and job-requirement extraction. There is no
# provider setting and no fallback, so this key is what makes those features
# work at all. Get one from https://aistudio.google.com/apikey
#
# Without it the API and worker still start, and everything that does not call
# a model still works — resume upload falls back to the deterministic parser,
# but publishing a job and running an interview will fail with a clear error.
#
# Embeddings do NOT use this key: the matching engine runs a local model
# in-process. See EMBEDDING_MODEL below.
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
# Retries inside a single request (408/429/5xx). The Celery task retries the
# whole job on top of this, so the two budgets multiply — keep this small.
LLM_MAX_RETRIES=2

# Matching engine (src/domains/matching/) — embeddings run **locally** on an
# open-source sentence-transformers model. No API key, no network call at
# request time; the weights (~440 MB) are downloaded from the Hugging Face
# hub on first use and cached.
#
# EMBEDDING_MODEL is not freely swappable: its output width must match the
# `vector(768)` column and ANN index (migration f4b81c26e9a7). A model of a
# different width needs a migration, and the app refuses to load one.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# cpu | cuda | mps | (empty = auto-detect)
EMBEDDING_DEVICE=
# Weight cache location. Empty = ~/.cache/huggingface. Point this at a mounted
# volume in Docker so the download happens once, not once per container start.
EMBEDDING_CACHE_DIR=
# Score (0-100) a (job, candidate) pair must reach to be persisted at all.
# Below it the pair is absent from `match_results` entirely — from both the
# recruiter's list and the candidate's feed, not hidden at read time. Raising
# this prunes existing rows on the next recompute, except pairs an application
# references, which are preserved deliberately.
#
# Set to 50.0 to match `matching/tiers.py::TIER_A_MIN_SCORE`, which is the
# product's *own* statement about what deserves a slot on a recruiter's board.
# The two knobs are deliberately separate — this one is a storage/compute
# bound, that one is a product rule — but as `scoring.py` notes, a threshold
# above 50 wins "by simple consequence": the row is not there to be tiered.
# At 60 the Tier A floor was unreachable and the board silently applied a
# stricter rule than the one the code documents. 50 hands the decision back to
# the tier logic, which is where it was designed to live.
MATCH_THRESHOLD=50.0

# Rank-fusion weights. MUST sum to 1.0 — the process refuses to start
# otherwise, because a score built from weights that do not is silently on a
# different scale than the one it is stored, compared, and thresholded on.
# Negative weights are rejected for the same reason.
MATCH_WEIGHT_SEMANTIC=0.40
MATCH_WEIGHT_SKILL_EVIDENCE=0.25
MATCH_WEIGHT_INTERVIEW=0.15
MATCH_WEIGHT_COMPETENCY=0.10
MATCH_WEIGHT_PROFILE_STRENGTH=0.10

# AI interview rubric (src/domains/interview/). Weights MUST sum to 1.0, same
# enforcement as above. Changing them does NOT rescore past interviews: every
# `interviews` row records the rubric version it was scored under, and an
# evidence report is written once and never edited.
#
# v3 is the live conversational interview's rubric. `repository_knowledge` is
# gone as a separate axis — it is folded into `code_understanding`, which the
# Scorer now judges across a whole conversation rather than one answer at a
# time. Interviews scored under v1/v2 keep their own dimensions forever.
INTERVIEW_RUBRIC_VERSION=3
INTERVIEW_WEIGHT_TECHNICAL_ACCURACY=0.40
INTERVIEW_WEIGHT_CODE_UNDERSTANDING=0.25
INTERVIEW_WEIGHT_PROBLEM_SOLVING=0.20
INTERVIEW_WEIGHT_COMMUNICATION=0.15

# The live session clock. INTERVIEW_TIME_LIMIT_SECONDS is copied onto each
# interview at creation, so changing it never shortens a session already
# underway. Below WRAPUP_THRESHOLD the interviewer stops starting new questions
# and closes gracefully instead — it must be smaller than the limit.
INTERVIEW_TIME_LIMIT_SECONDS=600
INTERVIEW_WRAPUP_THRESHOLD_SECONDS=90

# Verification layer (src/domains/verification/) — third-party checks run by
# src/jobs/tasks/verification.py.
# Optional server-side GitHub PAT: raises the unauthenticated rate limit
# (60 req/hr) to the authenticated tier (5000 req/hr) for candidates who
# haven't connected GitHub via OAuth. Never required.
GITHUB_API_TOKEN=
VERIFICATION_HTTP_TIMEOUT_SECONDS=15
GITHUB_RATE_LIMIT_PER_MINUTE=30
CODEFORCES_RATE_LIMIT_PER_MINUTE=20
LEETCODE_RATE_LIMIT_PER_MINUTE=20
# Platforms with no usable public API, checked by URL reachability only —
# these can reach FLAGGED but never VERIFIED, and produce no competencies.
HACKERRANK_RATE_LIMIT_PER_MINUTE=20
CODECHEF_RATE_LIMIT_PER_MINUTE=20
CERTIFICATE_CHECK_RATE_LIMIT_PER_MINUTE=30
