# App/runtime
APP_ENV=development
# Frontend origin used for redirects, reset links, and cookie flow.
FRONTEND_BASE_URL=http://localhost:5173
# Secure cookie flag for production deployments.
COOKIE_SECURE=false
# Primary FastAPI secret used for app-level signing or future use.
SECRET_KEY=
# Symmetric key (a `Fernet.generate_key()` value) used to encrypt third-party
# OAuth tokens at rest (GitHub). Leave blank in dev — a key is derived from
# SECRET_KEY instead; set a real generated one in any shared environment.
TOKEN_ENCRYPTION_KEY=

# Database
# SQLAlchemy connection string for Postgres.
DATABASE_URL=postgresql+psycopg://groundtruth:@localhost:5432/groundtruth

# Test database — a separate container (`make test-db-up`, port 5433).
# REQUIRED to run tests; tests/conftest.py hard-fails rather than falling
# back to DATABASE_URL if this is unset or resolves to a non-local host.
TEST_DATABASE_URL=postgresql+psycopg://groundtruth_test:groundtruth_test@localhost:5433/groundtruth_test

# JWT
# Signing secret for access, refresh, and state tokens.
JWT_SECRET_KEY=
# JWT algorithm used by the auth module.
JWT_ALGORITHM=HS256
# Access token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime in days.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# reCAPTCHA v2
# Public site key for the browser widget.
RECAPTCHA_SITE_KEY=
# Private secret key for server-side verification.
RECAPTCHA_SECRET_KEY=

# Mail
# Which Mailer backend `src/core/mail/backends.py` builds: "console" (logs
# only, default), "smtp" (real delivery — MailHog in docker-compose, a real
# provider in production), or "capture" (in-memory outbox, integration tests only).
MAIL_BACKEND=console
# SMTP host for transactional email delivery. docker-compose's `mailhog`
# service listens on localhost:1025 with no auth/TLS required.
SMTP_HOST=localhost
# SMTP port for the mail server.
SMTP_PORT=1025
# SMTP username used for authentication (leave blank for MailHog).
SMTP_USER=
# SMTP password used for authentication (leave blank for MailHog).
SMTP_PASSWORD=
# Whether to negotiate STARTTLS before sending (MailHog: false; most real providers: true).
SMTP_USE_TLS=false
# Sender address used in outbound auth emails.
SMTP_FROM_EMAIL=no-reply@groundtruth.ai

# Google OAuth
# OAuth client ID for the Google login flow.
GOOGLE_CLIENT_ID=
# OAuth client secret for the Google login flow.
GOOGLE_CLIENT_SECRET=
# Redirect URI registered in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# GitHub OAuth (read scopes only — connects a candidate's account to their
# GitHub identity for repository verification; see domains/student/github_oauth.py).
# OAuth App client ID, from github.com/settings/developers.
GITHUB_CLIENT_ID=
# OAuth App client secret.
GITHUB_CLIENT_SECRET=
# Callback URL registered on the GitHub OAuth App.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/student/github/callback
GITHUB_OAUTH_SCOPES=read:user public_repo

# CORS
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# Celery / Redis
# Broker and result backend for the background job layer.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Retry envelope: delay = base * 2**attempt, capped at max, with jitter.
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_BASE_SECONDS=5
JOB_RETRY_BACKOFF_MAX_SECONDS=600
# Hard/soft ceiling on a single task run, in seconds.
JOB_TIME_LIMIT_SECONDS=900
JOB_SOFT_TIME_LIMIT_SECONDS=840

# Object storage (S3-compatible: MinIO locally, S3/R2 in production)
# Leave the endpoint blank to talk to real AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=groundtruth
S3_SECRET_ACCESS_KEY=groundtruth-dev-secret
S3_RESUME_BUCKET=groundtruth-resumes
# Resumes are personal data: the bucket stays private and reads are presigned.
S3_PRESIGN_EXPIRY_SECONDS=300
# Uploads above this are rejected before the body is read (bytes).
RESUME_MAX_BYTES=10485760

# LLM provider
# Selects the adapter built by src/domains/ai/llm.py.
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Matching engine (src/domains/matching/) — embeddings via OpenAI (the one
# place this codebase talks to OpenAI rather than Anthropic; there is no
# Anthropic equivalent to text-embedding-3-small).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

# Verification layer (src/domains/verification/) — third-party checks run by
# src/jobs/tasks/verification.py.
# Optional server-side GitHub PAT: raises the unauthenticated rate limit
# (60 req/hr) to the authenticated tier (5000 req/hr) for candidates who
# haven't connected GitHub via OAuth. Never required.
GITHUB_API_TOKEN=
VERIFICATION_HTTP_TIMEOUT_SECONDS=15
GITHUB_RATE_LIMIT_PER_MINUTE=30
CODEFORCES_RATE_LIMIT_PER_MINUTE=20
LEETCODE_RATE_LIMIT_PER_MINUTE=20
CERTIFICATE_CHECK_RATE_LIMIT_PER_MINUTE=30
